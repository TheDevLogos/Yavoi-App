<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yavoi_navy">

    <fragment
        android:id="@+id/yavoi_navigation_fragment"
        android:name="com.google.android.libraries.navigation.SupportNavigationFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/navigation_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/yavoi_navigation_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/navigation_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAVEGACIÓN YAVOI!"
            android:textColor="@color/yavoi_orange"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navigation_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/yavoi_white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navigation_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#D5E0EA"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/navigation_primary_action"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/yavoi_navigation_primary"
            android:textAllCaps="false"
            android:textColor="@color/yavoi_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/navigation_return_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/yavoi_navigation_secondary"
            android:text="Ver viaje y solicitudes"
            android:textAllCaps="false"
            android:textColor="@color/yavoi_navy"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
